# Copy to .env.local. Never commit secrets.

DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-32-char-secret"
AUTH_URL="http://localhost:3000"

# Optional OAuth / magic link
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM="FiSure <noreply@localhost>"

# Feature flags — money stays off until counsel says otherwise
PAYMENTS_ENABLED="false"
CONTRIBUTIONS_PUBLIC="false"
PAYOUTS_AUTOMATED="false"
PAYMENTS_SIMULATE="true"

# Stripe (required only when PAYMENTS_ENABLED=true)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Object storage — local filesystem is the default
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# NASA FIRMS map key (optional)
# FIRMS_MAP_KEY=
