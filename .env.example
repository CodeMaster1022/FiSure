# Copy to .env.local. Never commit secrets.

# FiSure Express API (server/) — the real backend this frontend calls over HTTP
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Mapbox public token, used client-side for address autocomplete/geocoding
# on the owner property submission form. Public/publishable token — safe to
# expose to the browser (same model as a Stripe publishable key).
NEXT_PUBLIC_MAPBOX_TOKEN=""
