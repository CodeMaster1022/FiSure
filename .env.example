# Copy to .env.local. Never commit secrets.

# FiSure Express API (server/) — the real backend this frontend calls over HTTP
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Mapbox public token, used client-side for (1) address autocomplete/geocoding
# on the owner property submission form and (2) the funder dashboard's basemap
# tiles (ListingMap.tsx). Public/publishable token — safe to expose to the
# browser (same model as a Stripe publishable key). Mapbox bills per map load
# past a free tier (~50k/month) — worth monitoring once live with real traffic.
NEXT_PUBLIC_MAPBOX_TOKEN=""
